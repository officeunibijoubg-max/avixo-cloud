{
  "_note": "Библиотека от ъгли. Седмичният Claude Routine обновява ТОЗИ файл през PR — не пипа кода. Правилата за писане са в README.md.",

  "themes": {
    "light": ["cream-gold", "pearl-rose", "sand-olive", "linen-navy", "ivory-bordo", "paper-black", "mint-cocoa"],
    "dark":  ["oud-gold", "noir-champagne", "plum-gold"],
    "_rule": "Контрастът продукт↔фон решава, не светло/тъмно. Тъмен продукт → светла палитра. Блед продукт → тъмна палитра."
  },

  "proof": [
    { "t": "Гарантирано качество", "b": "100% оригинални аромати" },
    { "t": "Тест и преглед",       "b": "преди да платиш" },
    { "t": "Връщане и замяна",     "b": "лесно, без разправии" }
  ],

  "cta": "Поръчай сега",

  "angles": [
    { "id": "cena",             "for": "any",     "angle": "ЦЕНА — числото е героят",
      "kicker": "{{category}}", "hook": "{{price}}<u> €</u>", "ribbon": "Аромат, който помнят." },

    { "id": "na-flakon",        "for": "set",     "angle": "ЦЕНА НА ЕДИНИЦА — по-малкото число напред",
      "kicker": "{{bottles}} аромата", "hook": "ПО {{unit}} € ФЛАКОНА", "ribbon": "{{bottles}} аромата. Една цена.",
      "price_note": "{{bottles}} × {{ml}} мл в комплект" },

    { "id": "traynost",         "for": "any",     "angle": "ТРАЙНОСТ — атакува „изпарява се за час“",
      "kicker": "{{ml}} мл",    "hook": "ДЪРЖИ ЦЯЛ ДЕН", "ribbon": "Един пръст сутрин е достатъчен." },

    { "id": "bez-risk",         "for": "any",     "angle": "БЕЗ РИСК — офертата е условието на плащане",
      "kicker": "Поръчваш без риск", "hook": "ПЛАЩАШ НАКРАЯ", "ribbon": "Първо помирисваш. После плащаш.",
      "price_note": "плащаш при доставка" },

    { "id": "lyubopitstvo",     "for": "any",     "angle": "ЛЮБОПИТСТВО — сцена, не продукт",
      "kicker": "Арабски парфюм", "hook": "„КАКЪВ Е ТОЗИ?“", "ribbon": "Въпросът, който ще чуваш." },

    { "id": "stoynost",         "for": "any",     "angle": "СТОЙНОСТ — срещу дизайнерските марки",
      "kicker": "Луксозни аромати", "hook": "ЛУКС БЕЗ ЦЕНАТА МУ", "ribbon": "Същото усещане. Друга сметка." },

    { "id": "vpechatlenie",     "for": "any",     "angle": "ВПЕЧАТЛЕНИЕ — атакува „никой няма да забележи“",
      "kicker": "Дълготраен",   "hook": "ОСТАВА СЛЕД ТЕБ", "ribbon": "Аромат с присъствие." },

    { "id": "identichnost",     "for": "any",     "angle": "ИДЕНТИЧНОСТ — атакува „не е за мен“",
      "kicker": "Премиум композиция", "hook": "ЗА ЦЕНИТЕЛИ", "ribbon": "Аромат, който се разпознава." },

    { "id": "protivopostavyane","for": "any",     "angle": "ПРОТИВОПОСТАВЯНЕ — атакува „всички са еднакви“",
      "kicker": "Арабски парфюм", "hook": "НЕ Е КАТО ОСТАНАЛИТЕ", "ribbon": "Разпознават го отдалеч." },

    { "id": "podaruk",          "for": "set",     "angle": "ПОДАРЪК — сваля „какво да подаря“",
      "kicker": "Готов за подарък", "hook": "{{bottles}} ПОДАРЪКА", "ribbon": "Не се чудиш какво да подариш.",
      "price_note": "{{bottles}} аромата, един бюджет" },

    { "id": "povod",            "for": "set",     "angle": "ПОВОД — оправдава втория флакон",
      "kicker": "{{bottles}} аромата", "hook": "ДЕН И ВЕЧЕР", "ribbon": "Единият за офиса. Другият за после.",
      "price_note": "{{bottles}} аромата, всеки за друг повод" },

    { "id": "obem",             "for": "single",  "angle": "КОЛИЧЕСТВО — атакува „малко е за парите“",
      "kicker": "Пълен флакон", "hook": "{{ml}} МЛ", "ribbon": "Стига за месеци." },

    { "id": "raznoobrazie",     "for": "set",     "angle": "РАЗНООБРАЗИЕ — атакува „не знам кой аромат ще ми хареса“",
      "kicker": "Различни аромати", "hook": "{{bottles}} АРОМАТА", "ribbon": "Не избираш едно. Пробваш всички." },

    { "id": "podarak-edinichen","for": "single",  "angle": "ПОДАРЪК (единичен) — сваля „какво да подаря“ и при единичен флакон, не само при комплект",
      "kicker": "{{category}}", "hook": "ПОДАРИ УДОВОЛСТВИЕ", "ribbon": "Малка кутия. Голямо изживяване." },

    { "id": "vsekidnevie",      "for": "any",     "angle": "ЕЖЕДНЕВНОСТ — атакува съмнението „да не е твърде специален за всеки ден“",
      "kicker": "Ежедневен избор", "hook": "НОСИШ ГО ВСЕКИ ДЕН", "ribbon": "Не за специален повод. За твоя всеки ден." }
  ]
}
